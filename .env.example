# Local Supabase (supabase start / supabase db start). Never commit a real connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MCP_DB_ROLE=anon
# MCP_USER_ID=11111111-1111-4111-8111-111111111111   # required with MCP_DB_ROLE=authenticated
MCP_SCHEMAS=public
MCP_MAX_ROWS=100
MCP_STATEMENT_TIMEOUT_MS=5000
MCP_ALLOW_SQL=false
MCP_ALLOW_WRITES=false
